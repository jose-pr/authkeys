# Category rule: nothing dot-prefixed at the repo root gets tracked except the
# git config files and CI re-included below. Root-anchored on purpose; nested
# dotfiles are governed by the specific rules below.
/.*
!/.gitignore
!/.gitattributes
!/.github/

# Private agent config, never committed. No trailing slash on `.agents`: it may
# be a symlink, which a directory-only pattern would not match. *.local.* is an
# unshared, machine- or user-specific override.
.agents
*.local.*
CLAUDE*
.claude

# Build/dist output and generated docs site
build/
dist/
site/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
*.egg-info/
.pyvenv/
.venv/

# Project-specific scratch
/_*
/src/_*

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
